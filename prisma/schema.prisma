// Hyper Kidz Real Estate Location Tracker — Prisma schema
// Matches the live Supabase schema (locations, updates, launch plans, auth)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  MARKET_NO_SITE     @map("1 - Market (No Site)")
  SITE_SEARCH        @map("2 - Site Search")
  LOI                @map("3 - LOI")
  LEASE              @map("4 - Lease")
  UNDER_CONSTRUCTION @map("5 - Under Construction")
  OPEN               @map("6 - Open")
  ON_HOLD            @map("On Hold")
  DEAD               @map("Dead")

  @@map("stage")
}

enum Health {
  GREEN  @map("Green")
  YELLOW @map("Yellow")
  RED    @map("Red")

  @@map("health")
}

enum Priority {
  HIGH        @map("High")
  NORMAL      @map("Normal")
  BACK_BURNER @map("Back burner")

  @@map("priority")
}

enum Ownership {
  CORPORATE         @map("Corporate")
  FRANCHISE         @map("Franchise")
  CORPORATE_PARTNER @map("Corporate + Partner")

  @@map("ownership")
}

enum Format {
  WITH_FOOD_COURT    @map("With Food Court")
  WITHOUT_FOOD_COURT @map("Without Food Court")

  @@map("format")
}

enum LoiStatus {
  NOT_STARTED      @map("Not Started")
  DRAFTING         @map("Drafting")
  SENT_TO_LANDLORD @map("Sent to Landlord")
  COUNTER_RECEIVED @map("Counter Received")
  NEGOTIATING      @map("Negotiating")
  SIGNED           @map("Signed")
  DEAD             @map("Dead")

  @@map("loi_status")
}

enum TaskStatus {
  NOT_STARTED @map("Not Started")
  IN_PROGRESS @map("In Progress")
  DONE        @map("Done")
  N_A         @map("N/A")

  @@map("task_status")
}

enum Country {
  USA
  Canada
  Australia

  @@map("country")
}

enum UserRole {
  admin
  agent

  @@map("user_role")
}

enum ActivityAction {
  create
  edit
  delete

  @@map("activity_action")
}

model Location {
  id       String   @id
  name     String
  city     String?
  state    String?
  country  Country?
  address  String?
  landlord String?

  ownership   Ownership?
  format      Format?
  sqft        Int?
  stage       Stage     @default(SITE_SEARCH)
  health      Health?
  priority    Priority  @default(NORMAL)
  searchSince DateTime? @map("search_since") @db.Date

  loiStatus LoiStatus? @map("loi_status")
  loiSent   DateTime?  @map("loi_sent") @db.Date
  loiSigned DateTime?  @map("loi_signed") @db.Date

  leaseDraft    DateTime? @map("lease_draft") @db.Date
  leaseAttorney DateTime? @map("lease_attorney") @db.Date
  leaseSigned   DateTime? @map("lease_signed") @db.Date
  rentStart     DateTime? @map("rent_start") @db.Date
  freeRent      Int?      @map("free_rent")
  ti            Decimal?  @db.Decimal(12, 2)
  baseRent      Decimal?  @map("base_rent") @db.Decimal(12, 2)

  fddSigned   DateTime? @map("fdd_signed") @db.Date
  targetOpen  DateTime? @map("target_open") @db.Date
  actualOpen  DateTime? @map("actual_open") @db.Date
  notesMfi    String?   @map("notes_mfi")
  notes       String?
  drive       String?
  lastTouched DateTime? @map("last_touched")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  updates    LocationUpdate[]
  launchPlan LaunchPlan?

  @@index([stage])
  @@index([country])
  @@index([priority])
  @@index([health])
  @@index([targetOpen])
  @@map("locations")
}

model LocationUpdate {
  id         String   @id
  locationId String   @map("location_id")
  text       String
  authorName String   @map("author_name")
  at         DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, createdAt])
  @@map("location_updates")
}

model LaunchTemplate {
  id        String   @id @default(cuid())
  name      String
  days      Int      @default(270)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks LaunchTemplateTask[]
  plans LaunchPlan[]

  @@map("launch_templates")
}

model LaunchTemplateTask {
  id          String  @id @default(cuid())
  templateId  String  @map("template_id")
  tid         String
  phase       String
  task        String
  owner       String  @default("")
  startOffset Int     @map("start_day")
  endOffset   Int     @map("end_day")
  critical    Boolean @default(false)
  sortOrder   Int     @default(0) @map("sort_order")

  template LaunchTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, tid])
  @@index([templateId, sortOrder])
  @@map("template_tasks")
}

model LaunchPlan {
  id         String   @id @default(cuid())
  locationId String   @unique @map("location_id")
  templateId String?  @map("template_id")
  start      DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  template LaunchTemplate?     @relation(fields: [templateId], references: [id])
  tasks    LaunchPlanTask[]

  @@map("launch_plans")
}

model LaunchPlanTask {
  id          String     @id @default(cuid())
  planId      String     @map("plan_id")
  tid         String
  phase       String
  task        String
  owner       String     @default("")
  startOffset Int        @map("start_day")
  endOffset   Int        @map("end_day")
  critical    Boolean    @default(false)
  status      TaskStatus @default(NOT_STARTED)
  sortOrder   Int        @default(0) @map("sort_order")

  plan LaunchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, tid])
  @@index([planId, sortOrder])
  @@map("plan_tasks")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions     Session[]
  invitesSent  Invite[]      @relation("InviteSender")
  activityLogs ActivityLog[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        UserRole
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String?        @map("user_id")
  actorName  String         @map("actor_name")
  actorEmail String         @map("actor_email")
  actorRole  UserRole       @map("actor_role")
  action     ActivityAction
  entity     String
  entityId   String?        @map("entity_id")
  entityName String?        @map("entity_name")
  summary    String
  createdAt  DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}
